@model BankPortal.Models.UserRequest
@{
    ViewData["Title"] = "HomePage";
    Layout = "~/Views/Shared/_Layout.cshtml";


}



<link rel="stylesheet" href="~/css/navigation.css" />
<link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">

@if (Model.Role == Role.Customer)
{
<div>
    <marquee behavior="scroll" direction="left"><i class="material-icons">update</i>Stay tuned for important updates.</marquee>

</div>
    <h6 style="font-family:Verdana, Geneva, Tahoma, sans-serif">Hello,<i>@Model.Email</i>. Welcome to Internet Banking. </h6>
    <div class="text-center">
        <div class="container">
            <div class="row">
                <div class="col-sm-9 align-content-center">
                    <div class="service-box">
                        <div class="service-icon blue2">
                            <div class="front-content">
                                <i class="material-icons">savings</i>
                                <h3>Deposit</h3>
                            </div>
                        </div>
                        <a class="service-content" asp-area="" asp-controller="Customer" asp-action="Deposit">
                            <h3>Deposit</h3>
                            <p>INSTANT DEPOSIT TO YOUR ACCOUNT</p>
                        </a>
                    </div>
                </div>

                <div class="col-sm-9 rounded-pill" style="align-content:center">
                    <div class="service-box">
                        <div class="service-icon blue1">
                            <div class="front-content">
                                <i class="material-icons">atm</i>
                                <h3>Withdraw</h3>
                            </div>
                        </div>
                        <a class="service-content" asp-area="" asp-controller="Customer" asp-action="Withdraw">
                            <h3>Withdraw</h3>
                            <p> INSTANT WITHDRAWAL FROM ACCOUNT<br /></p>
                        </a>
                    </div>
                </div>

                <div class="col-sm-9 ">
                    <div class="service-box">
                        <div class="service-icon blue3">
                            <div class="front-content">
                                <i class="material-icons">swap_horiz</i>
                                <h3>Transfer</h3>
                            </div>
                        </div>
                        <a class="service-content" asp-area="" asp-controller="Customer" asp-action="Transfer">
                            <h3>Transfer</h3>
                            <p> INSTANT TRANSFER TO ANOTHER ACCOUNT</p>
                        </a>
                    </div>
                </div>
                <div class="col-sm-9 ">
                    <div class="service-box">
                        <div class="service-icon blue4">
                            <div class="front-content">
                                <!--  <i class="material-icons">account_balance</i>-->

                                <i class="material-icons">account_balance_wallet</i>
                                <h3>Account Balance</h3>
                            </div>
                        </div>
                        <a class="service-content" asp-area="" asp-controller="Customer" asp-action="GetCustomerAccounts" asp-route-id="@ViewBag.Id">
                            <h3>Account Balance</h3>
                            <p>Have a glance at your account balance</p>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

else
{
    <div class="text-center">

        <div class="container">

            <div class="row">
                <div class="col-md-12">
                    <div class="service-box ">
                        <div class="service-icon blue3">
                            <div class="front-content">
                                <i class="material-icons">people</i>
                                <h3>View Customers</h3>
                            </div>
                        </div>
                        <a class="service-content" asp-area="" asp-controller="Employee" asp-action="ViewCustomers">
                            <h3>View Customers</h3>
                        </a>
                    </div>
                </div>
                <div class="col-md-12">
                    <div class="service-box">
                        <div class="service-icon blue4">
                            <div class="front-content">
                                <i class="material-icons">person_add</i>
                                <h3>Add a Customer</h3>
                            </div>
                        </div>
                        <a class="service-content" asp-area="" asp-controller="Employee" asp-action="CreateCustomer">
                            <h3>Add a Customer</h3>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
}



